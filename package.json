{
  "name": "kunpengzhi-altar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --test scripts/run-tests.mjs",
    "test:waterway": "node scripts/verify-scorpion-waterway.mjs",
    "test:wuji": "node scripts/verify-wuji-absorber.mjs",
    "test:ritual": "node scripts/verify-ritual-timeline.mjs",
    "test:dragon": "node scripts/verify-dual-dragon.mjs",
    "test:audio": "node scripts/verify-audio-envelope.mjs",
    "test:physics": "node scripts/verify-physics-failure.mjs",
    "test:isolation": "node scripts/verify-entry-isolation.mjs",
    "test:narration": "node scripts/verify-ritual-narration.mjs",
    "capture": "node tools/capture/capture.mjs",
    "audit:entry": "node scripts/qa-audit-public-entry.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=kunpengzhi-altar"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "three": "^0.174.0",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.63.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "wrangler": "^4.130.0"
  }
